# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/inventario_db"

# Puerto del servidor
PORT=3000

# JWT Secret para autenticación
JWT_SECRET="tu_clave_secreta_muy_segura_cambiar_en_produccion"

# Origenes permitidos para CORS (separados por coma).
# En despliegue en red local, agrega aqui la IP/puerto donde sirvas el frontend,
# ej: "http://192.168.100.20:5173,http://192.168.100.20"
# (localhost:<cualquier puerto> siempre se permite automaticamente)
CORS_ORIGINS="http://localhost:5173,http://localhost:3001,http://localhost:3000"

# URL base publica del backend, usada para construir las URLs de /uploads.
# Si se deja vacio, se infiere automaticamente del request (protocolo+host).
# Solo defínela si accedes por IP/dominio distinto al que recibe la peticion.
BASE_URL=""

# Cloudinary (para manejo de imágenes)
CLOUDINARY_NAME="tu_cloudinary_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Node Environment
NODE_ENV="development"
